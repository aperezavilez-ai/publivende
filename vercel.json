{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "crons": [
    { "path": "/api/cron/sync-metrics", "schedule": "*/30 * * * *" },
    { "path": "/api/cron/publish-scheduled", "schedule": "* * * * *" },
    { "path": "/api/cron/autopilot", "schedule": "0 * * * *" },
    { "path": "/api/cron/benchmarks", "schedule": "0 6 * * *" },
    { "path": "/api/cron/discovery", "schedule": "0 5 * * 1" }
  ]
}
