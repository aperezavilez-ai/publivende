# PubliVende — plantilla de variables de entorno.
# SOLO placeholders vacíos: nunca pegues valores reales en este archivo.
# Los valores reales viven en Vercel (Production) y en tu .env.local sin versionar.

# Base de datos / sesión (modo producción)
DATABASE_URL=
SESSION_SECRET=
CRON_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
