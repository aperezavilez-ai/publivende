# URL pública de la app (sin barra final)
VITE_APP_URL=http://localhost:8083

# === PRODUCCIÓN (obligatorio para modo real) ===
# Supabase/Neon Postgres connection string
DATABASE_URL=
# Secreto JWT sesiones (min 32 caracteres aleatorios)
SESSION_SECRET=

# OAuth state signing
OAUTH_STATE_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# --- Meta (Facebook + Instagram + WhatsApp) ---
META_APP_ID=
META_APP_SECRET=

# --- Google (YouTube) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- WhatsApp Cloud API (plataforma / fallback admin) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=publivende_verify
# UUID del usuario admin (solo fallback legacy si no hay multi-tenant)
WHATSAPP_DEFAULT_USER_ID=

# --- WhatsApp Embedded Signup (cada cliente conecta SU número) ---
# Configuration ID desde Meta → WhatsApp → Embedded Signup
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# --- IA (MeAI, token propio de este proyecto) ---
MEAI_API_KEY=
MEAI_MODEL=claude-haiku-4-5

# --- Pagos (Stripe — principal) ---
STRIPE_SECRET_KEY=sk_test_...
# Webhook: https://www.publivende.mx/api/webhook/stripe
# Eventos: checkout.session.completed, customer.subscription.created/updated/deleted
STRIPE_WEBHOOK_SECRET=whsec_...
# Opcional: Price IDs mensuales en MXN (si faltan se usa el precio de src/lib/plans.ts)
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- Solo modo demo (sin base de datos): emails separados por coma que serán admin ---
VITE_DEMO_ADMIN_EMAILS=

# --- MercadoPago (opcional, LATAM) ---
# MERCADOPAGO_ACCESS_TOKEN=

# --- Meta Ads (amplificación orgánica → pagada) ---
META_AD_ACCOUNT_ID=
# Presupuesto diario sugerido en centavos MXN para boost automático (opcional)
META_BOOST_DAILY_BUDGET_CENTS=5000


# --- Plataforma API (marca blanca / otros proyectos) ---
# Partners y API keys se gestionan en /plataforma (admin). Formato key: pv_live_...

# Production (Vercel): set all vars in Project → Settings → Environment Variables
VITE_APP_URL=https://www.publivende.mx
